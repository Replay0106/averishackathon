# ==============================================================================
# NavisAI | Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' and provide your Google Gemini API key:
#   copy .env.example .env
#
# Obtain a free API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
# ==============================================================================

# Google Gemini API Key (used for Multimodal Vision & AI Copilot reasoning)
GEMINI_API_KEY="your_google_gemini_api_key_here"

# Multi-Key Quota Pool (comma-separated):
# Automatically rotates to the next key when one reaches daily free-tier quota (20 requests/day per model)
# GEMINI_API_KEYS="key1,key2,key3"

# Preferred Default Gemini Model:
# GEMINI_MODEL="gemini-3.6-flash"

# Alternative alias accepted by the system:
# GOOGLE_API_KEY="your_google_gemini_api_key_here"

# ------------------------------------------------------------------------------
# Gmail OAuth (optional secure inbox integration)
#
# In Google Cloud Console, enable Gmail API and create an OAuth 2.0 "Web
# application" client. Add this exact authorised redirect URI:
#   http://localhost:8000/api/gmail/callback
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:8000/api/gmail/callback"
GMAIL_FRONTEND_URL="http://localhost:5173/#/settings"

# Generate once and keep stable. Changing it makes stored tokens unreadable:
#   .\venv\Scripts\python.exe -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_ENCRYPTION_KEY="replace-with-url-safe-base64-32-byte-key"

# Only mail with this Gmail label is imported. Gmail access is read-only.
GMAIL_LABEL="NavisAI"
GMAIL_SYNC_MAX_MESSAGES="100"
GMAIL_MAX_ATTACHMENT_MB="15"
GMAIL_MAX_SYNC_MB="100"

# Keep false for local HTTP. Set true when both API and UI are served over HTTPS.
COOKIE_SECURE="false"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
